# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: mesh_node1
label: mesh_node1
description: |
  This example demonstrates the Bluetooth Mesh Sensor Server Model and Sensor Setup Server Model. If available, it measures CPU temperature and uses that data as temperature reading, otherwise it sends mocked temperature data to a remote device (e.g., btmesh_soc_sensor_client). This example runs on top of FreeRTOS.
category: Bluetooth Mesh Examples
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Advanced]
- name: Wireless Technology
  value: [Bluetooth Mesh]
package: Btmesh
quality: production
readme:
- {path: readme_freertos.md}
- {path: readme_freertos.md}
source:
- {path: app.c}
- {path: app_freertos.c}
- {path: app_out_log.c}
- {path: local_cli_commands.c}
tag: ['hardware:component:display:!ls013b7dh03', 'hardware:component:button:1+', 'hardware:rf:band:2400',
  'hardware:component:sensor:!si7021', 'hardware:device:flash:512', 'hardware:board_only',
  'hardware:component:led:1+', 'hardware:device:ram:64']
include:
- path: .
  file_list:
  - {path: app.h}
sdk: {id: simplicity_sdk, version: 2025.6.3}
toolchain_settings: []
component:
- {id: EFR32MG24B210F1536IM48}
- {id: app_assert}
- {id: app_button_press}
- {id: app_log}
- {id: app_timer}
- {id: bootloader_interface}
- {id: brd2703a_a02}
- {id: bt_post_build}
- {id: btmesh_factory_reset}
- {id: btmesh_generic_base}
- {id: btmesh_iv_update}
- {id: btmesh_provisionee}
- {id: btmesh_provisioning_decorator}
- {id: btmesh_proxy}
- {id: btmesh_sensor_server}
- {id: btmesh_stack_gatt_prov_bearer}
- {id: btmesh_stack_generic_server}
- {id: btmesh_stack_relay}
- {id: btmesh_stack_vendor_model}
- instance: [example]
  id: cli
- {id: clock_manager}
- {id: device_init}
- {id: freertos}
- {id: gatt_service_device_information_override}
- instance: [qwiic]
  id: i2cspm
- {id: iostream_recommended_stream}
- {id: mpu}
- {id: rail_util_pti}
- {id: sensor_rht_mock}
- {id: simple_button_recommended_instance}
- {id: simple_led_recommended_instance}
- {id: sl_main}
- {id: udelay}
other_file:
- {path: readme_img0.png}
- {path: readme_img1.png}
- {path: readme_img2.png}
- {path: readme_img3.png}
- {path: readme_img4.png}
- {path: readme_img5.png}
- {path: readme_img6.png}
- {path: readme_img7.png}
- {path: readme_img8.png}
template_contribution:
- name: cli_command
  priority: 0
  value: {name: info, handler: info, help: Prints info about BT address and mesh UUID}
configuration:
- {name: EMDRV_DMADRV_DMA_CH_COUNT, value: '2'}
- {name: APP_LOG_LEVEL, value: APP_LOG_LEVEL_INFO}
- {name: APP_BUTTON_PRESS_CONFIG_QUEUE_SIZE, value: '4'}
- {name: configTIMER_TASK_STACK_DEPTH, value: '240'}
- {name: NVM3_DEFAULT_CACHE_SIZE, value: '100'}
- {name: NVM3_DEFAULT_NVM_SIZE, value: '0x6000'}
- {name: SL_BT_RTOS_HOST_STACK_TASK_STACK_SIZE, value: '4000'}
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}
- {name: SL_BTMESH_PROVISIONEE_AUTO_RESET_DELAY, value: '1'}
- {name: SL_BTMESH_CONFIG_MAX_PROV_BEARERS, value: '3'}
- condition: [device_sdid_205]
  name: SL_CLI_NUM_HISTORY_BYTES
  value: '0'
- condition: [psa_crypto]
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
- {name: SL_SIMPLE_BUTTON_ALLOW_LED_CONFLICT, value: '1'}
ui_hints:
  highlight:
  - {path: config/btconf/gatt_configuration.btconf}
  - {path: config/btmeshconf/dcd_config.btmeshconf}
  - {path: readme_freertos.md, focus: true}
post_build:
- {path: mesh_node1.slpb, profile: btmesh_common}

